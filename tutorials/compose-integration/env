#NGINX_TEMPLATE=tls
#NGINX_PRIVATE_KEY={{ TLS_LIVE_DIR }}/{{ CA_HOSTNAME }}/privkey.pem
#NGINX_PUBLIC_KEY={{ TLS_LIVE_DIR }}/{{ CA_HOSTNAME }}/fullchain.pem
